# Copy to .env and fill in. .env is git-ignored; never commit a real key.
SCHEMESSG_API_KEY=PASTE_KEY_HERE
# Production partner API (schemes.sg/developers). Production is the source of
# truth; dev is outdated. The docs' ".../partner_api/v1" form also works.
SCHEMESSG_BASE_URL=https://asia-southeast1-schemessg.cloudfunctions.net/partner_api
# prod (default) or dev. prod adds a schemes.sg link to each scheme's sources.
SCHEMESSG_ENV=prod
